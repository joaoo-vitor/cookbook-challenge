  "steps": [
    {
      "n": 1,
      "text": "Zum Einlegen kocht man 1/2 l Essig, 1/2 l Wasser, 4 in Scheiben geschnittene Zwiebeln, Pfeffer, Nelken, Salz und Lorbeerblätter.",
      "ingredient_ids": [
        "i1",
        "i2",
        "i3",
        "i4",
        "i5",
        "i6",
        "i7"
      ],
      "tool_ids": [],
      "duration_text": null,
      "condition": null,
      "quote": "Zum Einlegen kocht man 1/2 l Essig, 1/2 l\nWasser, 4 in Scheiben geschnittene Zwiebeln,\nPfeffer, Nelken, Salz und Lorbeerblätter.",
      "lines": [
        "p1:L13",
        "p1:L14",
        "p1:L15"
      ]
    },
    {
      "n": 2,
      "text": "Will man den Braten nach dem 1. Tag oder 2. Tag gebrauchen, so gießt man das Essigwasser heiß darüber. Soll der Braten erst nach 8 Tagen zubereitet werden, so gießt man es kalt darauf.",
      "ingredient_ids": [
        "i1",
        "i2"
      ],
      "tool_ids": [],
      "duration_text": null,
      "condition": null,
      "quote": "Will man den Braten nach dem 1. Tag oder\n2. Tag gebrauchen, so gießt man das Essig-\nwasser heiß darüber. Soll der Braten erst\nnach 8 Tagen zubereitet werden, so gießt man\nes kalt darauf.",
      "lines": [
        "p2:L2",
        "p2:L3",
        "p2:L4",
        "p2:L5",
        "p2:L6"
      ]
    },
    {
      "n": 3,
      "text": "Zum Anbraten den Speck auslassen, Butter dazugeben, dann gibt man den abgetrockneten Braten ins heiße Fett.",
      "ingredient_ids": [
        "i8",
        "i9",
        "i10"
      ],
      "tool_ids": [],
      "duration_text": null,
      "condition": null,
      "quote": "Zum Anbraten den Speck auslassen, Butter\ndazugeben, dann gibt man den abgetrockne-\nten Braten ins heiße Fett.",
      "lines": [
        "p2:L7",
        "p2:L8",
        "p2:L9"
      ]
    },
    {
      "n": 4,
      "text": "Wenn er von allen Seiten knusprig angebraten ist, gießt man etwas Essigwasser hinzu.",
      "ingredient_ids": [
        "i1",
        "i2"
      ],
      "tool_ids": [],
      "duration_text": null,
      "condition": "Wenn er von allen Seiten knusprig angebraten ist",
      "quote": "Wenn er von al-\nlen Seiten knusprig angebraten ist, gießt man\netwas Essigwasser hinzu.",
      "lines": [
        "p2:L9",
        "p2:L10",
        "p2:L11"
      ]
    },
    {
      "n": 5,
      "text": "Auch kann man einige Äpfel, Möhren und Wacholderbeeren in den Topf geben.",
      "ingredient_ids": [
        "i11",
        "i12",
        "i13"
      ],
      "tool_ids": [
        "t1"
      ],
      "duration_text": null,
      "condition": null,
      "quote": "Auch kann man einige Äpfel, Möhren und\nWacholderbeeren in den Topf geben.",
      "lines": [
        "p2:L12",
        "p2:L13"
      ]
    },
    {
      "n": 6,
      "text": "Man läßt den Braten langsam mit den Zutaten garbrötscheln.",
      "ingredient_ids": [
        "i10"
      ],
      "tool_ids": [],
      "duration_text": null,
      "condition": null,
      "quote": "Man läßt\nden Braten langsam mit den Zutaten gar-\nbrötscheln.",
      "lines": [
        "p2:L13",
        "p2:L14",
        "p2:L15"
      ]
    },
    {
      "n": 7,
      "text": "Für die Soße schwitzt man den Bratenfond mit Mehl an, füllt mit Essigwasser und Rotwein auf, gibt dann gequollene Korinthen u. Rosinen hinzu und soviel Zucker, daß die Soße einen säuerlich-süßen Geschmack bekommt.",
      "ingredient_ids": [
        "i1",
        "i2",
        "i14",
        "i15",
        "i16",
        "i17",
        "i18"
      ],
      "tool_ids": [],
      "duration_text": null,
      "condition": null,
      "quote": "Für die Soße schwitzt man den Bratenfond\nmit Mehl an, füllt mit Essigwasser und Rot-\nwein auf, gibt dann gequollene Korinthen u.\nRosinen hinzu und soviel Zucker, daß die\nSoße einen säuerlich-süßen Geschmack\nbekommt.",
      "lines": [
        "p2:L16",
        "p2:L17",
        "p2:L18",
        "p2:L19",
        "p2:L20",
        "p2:L21"
      ]
    },
    {
      "n": 8,
      "text": "Man legt den Braten, wenn er noch nicht geschnitten ist, eine Stunde vor dem Anrichten in die Soße, damit er den Geschmack derselben bekommt.",
      "ingredient_ids": [
        "i10"
      ],
      "tool_ids": [],
      "duration_text": "eine Stunde",
      "condition": null,
      "quote": "Man legt den Braten, wenn er noch nicht ge-\nschnitten ist, eine Stunde vor dem Anrich-\nten in die Soße, damit er den Geschmack\nderselben bekommt.",
      "lines": [
        "p2:L22",
        "p2:L23",
